{
  "name": "aman-system-android",
  "version": "15.5.1",
  "private": true,
  "scripts": {
    "setup-ocr": "node scripts/setup-ocr.mjs",
    "postinstall": "node scripts/setup-ocr.mjs || echo OCR setup skipped",
    "prepare-www": "npm run ui:build && node scripts/prepare-www.mjs",
    "android:init": "node scripts/android-init.mjs",
    "android:sync": "npm run prepare-www && npx cap sync android",
    "ui:build": "node scripts/lint-vue.mjs && vite build --config ui/vite.config.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.0",
    "xlsx": "0.18.5",
    "chart.js": "^4.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@primeuix/themes": "^1.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "primevue": "^4.3.0",
    "vite": "^6.0.0",
    "vue": "^3.5.13"
  }
}
